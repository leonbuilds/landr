generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  passwordHash String
  name         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  resumes      Resume[]
  jobs         Job[]
  applications Application[]
  settings     Setting[]
  searchTasks  SearchTask[]
  jdFetchTasks JdFetchTask[]
}

model Resume {
  id           Int           @id @default(autoincrement())
  userId       Int
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  rawText      String?
  parsedJson   String?
  filePath     String?
  diagnosis    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applications Application[]
}

model Job {
  id          Int           @id @default(autoincrement())
  userId      Int
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  company     String?
  platform    String?
  jdText      String?
  parsedJson  String?
  salaryRange String?
  location    String?
  url         String?
  createdAt   DateTime      @default(now())
  applications Application[]
  jdFetchTask  JdFetchTask?
}

model Application {
  id             Int         @id @default(autoincrement())
  userId         Int
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId       Int?
  resume         Resume?     @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  jobId          Int?
  job            Job?        @relation(fields: [jobId], references: [id], onDelete: SetNull)
  status         String      @default("draft")
  matchScore     Int?
  matchDetail    String?
  tailoredResume String?
  coverLetter    String?
  interviewPrep  String?
  notes          String?
  appliedAt      DateTime?
  nextFollowup   DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  statusLogs     StatusLog[]
}

model StatusLog {
  id            Int         @id @default(autoincrement())
  applicationId Int
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus    String?
  toStatus      String?
  note          String?
  createdAt     DateTime    @default(now())
}

model Setting {
  id     Int    @id @default(autoincrement())
  userId Int
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  key    String
  value  String?

  @@unique([userId, key])
}

// 自主搜岗位任务：用户提交一句话或选简历 → 后端 LLM 解析为 Boss 搜索参数 →
// 扩展 service worker 轮询拿到任务 → 自动开 Boss 搜索页 → 翻页采集 → 回传结果
model SearchTask {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  source    String   // "prompt" | "resume"
  prompt    String?  // 原始 user 输入或简历 rawText 片段
  resumeId  Int?
  params    String   // JSON: {query, city, cityCode, salaryMin, salaryMax, pages, platform}
  status    String   @default("pending") // pending | running | done | failed
  collected Int      @default(0)
  skipped   Int      @default(0)
  message   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// JD 二次抓取任务：搜任务终态后，对每条新入库的 Boss 岗位入队一条 fetch task。
// 扩展 SW 串行拾取 → 后台开详情 tab → extractor.extractDetail() → PATCH 回传 jdText。
// 失败保留列表摘要兜底，不阻塞匹配。
model JdFetchTask {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     Int      @unique
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status    String   @default("pending") // pending | running | done | failed
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}
