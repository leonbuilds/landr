# ─────────────────────────────────────────────────────────
#  AI 求职 Agent · 环境变量样例
#  Usage: cp .env.example .env  →  fill values  →  pnpm dev
# ─────────────────────────────────────────────────────────

# === 必填 · 应用密钥 ===

# JWT 签发密钥(用于用户登录 token)
# 生成: openssl rand -base64 48
JWT_SECRET=please-replace-with-random-48-byte-secret

# 用户 LLM API Key 的对称加密密钥(AES-256-GCM)
# 生成: openssl rand -hex 32
ENCRYPTION_KEY=please-replace-with-random-32-byte-hex


# === 必填 · 数据库 ===

# Prisma 连接串。本地开发用 SQLite,生产建议 Postgres
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:pass@host:5432/aija"


# === 可选 · 仅 e2e/verify 脚本需要 ===

# 用于 scripts/e2e-*.ts 与 scripts/verify-*.ts 的 LLM Key
# (生产环境的 LLM Key 由用户在「设置」页填入,加密存 DB,不读这个 env)
DEEPSEEK_KEY=sk-your-deepseek-key-here

# 端到端脚本读的真实 PDF 简历路径
RESUME_PDF=/path/to/your/resume.pdf

# 测试主站基址(默认 http://localhost:3000)
BASE=http://localhost:3000
